# Pega tu key aquí (solo local; .env está en .gitignore)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3001

# true = no llama a Gemini, usa detecciones de demo (plan B sin internet)
MOCK=false

# Tiempo máximo de espera a Gemini en milisegundos (sube si tu internet es lento)
GEMINI_TIMEOUT_MS=25000
