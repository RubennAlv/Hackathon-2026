{
  "name": "origen-dgo-lens",
  "version": "1.0.0",
  "description": "Lens Local: API de reconocimiento de productos y matching con productores de Durango (Origen DGO)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "fuser -k 3001/tcp 2>/dev/null || true",
    "start": "node server.js",
    "predev": "fuser -k 3001/tcp 2>/dev/null || true",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "test": "node scripts/test.js",
    "qa": "node scripts/qa_verification.js",
    "reset:env": "node scripts/reset_test_env.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.5.0"
  }
}
